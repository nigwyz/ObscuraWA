+#[derive(Serialize, Deserialize)]
+struct Snapshot {
+    databases: Vec<SnapshotDatabase>,
+}
+
+#[derive(Serialize, Deserialize)]
+struct SnapshotDatabase {
+    origin: String,
+    name: String,
+    version: u64,
+    #[serde(default)]
+    schema: Vec<Value>,
+    #[serde(default)]
+    records: HashMap<String, HashMap<String, String>>,
+}
+
+fn load_snapshot(path: &Path) -> std::io::Result<Inner> {
+    let bytes = std::fs::read(path)?;
+    let snapshot: Snapshot =
+        serde_json::from_slice(&bytes).map_err(std::io::Error::other)?;
+    let mut inner = Inner::default();
+    for database in snapshot.databases {
+        let schema_bytes = database
+            .schema
+            .iter()
+            .map(|value| value.to_string().len())
+            .sum::<usize>();
+        let record_bytes = database
+            .records
+            .values()
+            .flat_map(|store| store.iter())
+            .map(|(key, value)| key.len() + value.len() + RECORD_OVERHEAD)
+            .sum::<usize>();
+        inner.bytes = inner.bytes.saturating_add(schema_bytes + record_bytes);
+        inner.databases.insert(
+            (database.origin, database.name),
+            Database {
+                version: database.version,
+                schema: database.schema,
+                records: database.records,
+                schema_bytes,
+                ..Default::default()
+            },
+        );
+    }
+    Ok(inner)
+}
+
+fn write_snapshot(path: &Path, inner: &Arc<Mutex<Inner>>) -> std::io::Result<()> {
+    let snapshot = {
+        let inner = inner.lock().unwrap_or_else(|error| error.into_inner());
+        Snapshot {
+            databases: inner
+                .databases
+                .iter()
+                .map(|((origin, name), database)| SnapshotDatabase {
+                    origin: origin.clone(),
+                    name: name.clone(),
+                    version: database.version,
+                    schema: database.schema.clone(),
+                    records: database.records.clone(),
+                })
+                .collect(),
+        }
+    };
+    let bytes = serde_json::to_vec(&snapshot).map_err(std::io::Error::other)?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let temporary = path.with_extension("json.tmp");
+    std::fs::write(&temporary, bytes)?;
+    std::fs::rename(&temporary, path)?;
+    Ok(())
+}
