 }
 
 impl IndexedDbStorage {
+    pub fn new(path: Option<PathBuf>) -> Self {
+        let inner = path
+            .as_deref()
+            .and_then(|path| match load_snapshot(path) {
+                Ok(inner) => Some(inner),
+                Err(error) => {
+                    tracing::warn!(
+                        "Could not load IndexedDB snapshot {}: {error}",
+                        path.display()
+                    );
+                    None
+                }
+            })
+            .unwrap_or_default();
+        let inner = Arc::new(Mutex::new(inner));
+        let dirty = Arc::new(AtomicBool::new(false));
+
+        if let Some(path) = path.clone() {
+            let weak = Arc::downgrade(&inner);
+            let dirty_thread = dirty.clone();
+            std::thread::spawn(move || loop {
+                std::thread::sleep(Duration::from_secs(2));
+                let Some(inner) = weak.upgrade() else {
+                    break;
+                };
+                if dirty_thread.swap(false, Ordering::AcqRel) {
+                    if let Err(error) = write_snapshot(&path, &inner) {
+                        tracing::warn!(
+                            "Could not flush IndexedDB snapshot {}: {error}",
+                            path.display()
+                        );
+                        dirty_thread.store(true, Ordering::Release);
+                    }
+                }
+            });
+        }
+
+        Self {
+            inner,
+            pending_notices: AtomicBool::new(false),
+            path,
+            dirty,
+        }
+    }
+
     pub fn has_pending_notifications(&self) -> bool {
-        self.pending_notices.load(std::sync::atomic::Ordering::Acquire)
+        self.pending_notices.load(Ordering::Acquire)
+    }
+
+    /// Write the current snapshot immediately. The periodic flusher covers
+    /// normal operation; this is for graceful shutdown and tests.
+    pub fn flush(&self) -> std::io::Result<()> {
+        let Some(path) = &self.path else {
+            return Ok(());
+        };
+        write_snapshot(path, &self.inner)?;
+        self.dirty.store(false, Ordering::Release);
+        Ok(())
+    }
+
+    pub fn is_dirty(&self) -> bool {
+        self.dirty.load(Ordering::Acquire)
+    }
+}
+
+impl Drop for IndexedDbStorage {
+    fn drop(&mut self) {
+        let _ = self.flush();
     }
 }
 
